{
  "schemaVersion": 1,
  "id": "copium",
  "version": "${version}",
  "name": "Copium Client",
  "description": "Fabric client with skies, HUD, Spotify player, ESP, movement, combat and DonutSMP utilities. Forked from SoberClient by Violet.",
  "authors": [
    "floplingg"
  ],
  "license": "GPL-3.0-or-later",
  "icon": "assets/violet/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.violet.SoberClient"
    ]
  },
  "mixins": [
    "copium.mixins.json",
    "copium.features.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.2",
    "fabric-api": "*",
    "minecraft": "1.21.11",
    "java": ">=21"
  },
  "contributors": [
    "Violet (SoberClient)",
    "2660master (SkyFX)"
  ],
  "contact": {
    "sources": "https://github.com/floplingg/COPIUM",
    "homepage": "https://github.com/floplingg/COPIUM"
  }
}
